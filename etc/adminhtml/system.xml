<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="catalog_sorting">
            <group id="reviews_count" translate="label" type="text" sortOrder="140"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Reviews Count</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <comment>Offers "Reviews Count" in Sort By: the products with the most customer reviews first. The counts are recomputed by the daily popularity data refresh.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
