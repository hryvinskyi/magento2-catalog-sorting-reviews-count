<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        All three registrations are global: the refresh runs from cron and the command line, the document fields
        at index time, the sort field on every search request, and the listing option in every area that lists
        sort orders.
    -->
    <virtualType name="HryvinskyiCatalogSortingReviewsCountMetric"
                 type="Hryvinskyi\CatalogSortingMetrics\Model\ConfiguredMetric">
        <arguments>
            <argument name="source" xsi:type="object">Hryvinskyi\CatalogSortingReviewsCount\Model\ResourceModel\ReviewsCountMetricSource</argument>
            <argument name="code" xsi:type="string">reviews_count</argument>
            <argument name="documentField" xsi:type="string">sort_reviews_count</argument>
            <argument name="fieldType" xsi:type="string">long</argument>
            <argument name="enabledPath" xsi:type="string">catalog_sorting/reviews_count/enabled</argument>
        </arguments>
    </virtualType>
    <type name="Hryvinskyi\CatalogSortingMetrics\Model\MetricRegistry">
        <arguments>
            <argument name="metrics" xsi:type="array">
                <item name="reviews_count" xsi:type="object">HryvinskyiCatalogSortingReviewsCountMetric</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="HryvinskyiCatalogSortingReviewsCountSortField"
                 type="Hryvinskyi\CatalogSorting\Model\ConfiguredShopperSortField">
        <arguments>
            <argument name="code" xsi:type="string">reviews_count</argument>
            <argument name="field" xsi:type="string">sort_reviews_count</argument>
            <argument name="fieldType" xsi:type="string">long</argument>
            <argument name="missingValue" xsi:type="number">0</argument>
        </arguments>
    </virtualType>
    <type name="Hryvinskyi\CatalogSorting\Model\Search\ShopperSortFields">
        <arguments>
            <argument name="sortFields" xsi:type="array">
                <item name="reviews_count" xsi:type="object">HryvinskyiCatalogSortingReviewsCountSortField</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="HryvinskyiCatalogSortingReviewsCountListingOption"
                 type="Hryvinskyi\CatalogSortingOptions\Model\ConfigFlagListingSortOption">
        <arguments>
            <argument name="code" xsi:type="string">reviews_count</argument>
            <argument name="label" xsi:type="string" translate="true">Reviews Count</argument>
            <argument name="enabledPath" xsi:type="string">catalog_sorting/reviews_count/enabled</argument>
            <argument name="defaultDirection" xsi:type="string">desc</argument>
        </arguments>
    </virtualType>
    <type name="Hryvinskyi\CatalogSortingOptions\Model\ListingSortOptions">
        <arguments>
            <argument name="options" xsi:type="array">
                <item name="reviews_count" xsi:type="object" sortOrder="140">HryvinskyiCatalogSortingReviewsCountListingOption</item>
            </argument>
        </arguments>
    </type>
</config>
